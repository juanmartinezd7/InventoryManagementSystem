@page
@model IndexModel
@{
    ViewData["Title"] = "Home";
}

<div class="text-center">
    <h1 class="display-4">@Model.ApplicationName</h1>

    <p class="lead">@Model.WelcomeMessage</p>

    <hr />

    <p>
        <strong>Server Date and Time:</strong>
        @Model.CurrentDateTime.ToString("MMMM dd, yyyy hh:mm:ss tt")
    </p>

    <p>
        <strong>Total Active Products:</strong>
        @Model.ProductCount
    </p>
</div>





